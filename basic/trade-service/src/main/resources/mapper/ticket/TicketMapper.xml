<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yean.trade.ticket.mapper.TicketMapper">

    <resultMap id="TicketResultMap" type="com.yean.trade.ticket.dto.Ticket">
        <id column="id" property="id"/>
        <result column="aftersale_no" property="aftersaleNo"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="type" property="type"/>
        <result column="status" property="status"/>
        <result column="sku_id" property="skuId"/>
        <result column="sku_name" property="skuName"/>
        <result column="exchange_sku_id" property="exchangeSkuId"/>
        <result column="num" property="num"/>
        <result column="amount" property="amount"/>
        <result column="reason" property="reason"/>
        <result column="logistics_info" property="logisticsInfo"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="refund_detail" property="refundDetail"
                typeHandler="com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler"/>
        <result column="active_flag" property="activeFlag"/>
        <result column="process_instance_id" property="processInstanceId"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="TicketColumns">
        id, aftersale_no, order_no, user_id, merchant_id, type, status, sku_id, sku_name, exchange_sku_id, num, amount,
        reason, logistics_info, refund_detail, active_flag, process_instance_id, create_time, update_time
    </sql>

    <select id="selectByAftersaleNo" resultMap="TicketResultMap">
        SELECT <include refid="TicketColumns"/>
        FROM aftersale_ticket
        WHERE aftersale_no = #{aftersaleNo}
    </select>

    <select id="selectActiveByOrderNoAndSkuId" resultMap="TicketResultMap">
        SELECT <include refid="TicketColumns"/>
        FROM aftersale_ticket
        WHERE order_no = #{orderNo}
          AND sku_id = #{skuId}
          AND active_flag = 1
    </select>

    <select id="selectDraftByUserOrderSku" resultMap="TicketResultMap">
        SELECT <include refid="TicketColumns"/>
        FROM aftersale_ticket
        WHERE user_id = #{userId}
          AND order_no = #{orderNo}
          AND sku_id = #{skuId}
          AND status = -1
        ORDER BY id DESC
        LIMIT 1
    </select>

    <select id="selectDraftsByUserId" resultMap="TicketResultMap">
        SELECT <include refid="TicketColumns"/>
        FROM aftersale_ticket
        WHERE user_id = #{userId}
          AND status = -1
        ORDER BY id DESC
    </select>

    <select id="selectListByQuery" resultMap="TicketResultMap">
        SELECT <include refid="TicketColumns"/>
        FROM aftersale_ticket
        <where>
            <!-- 默认排除草稿；显式查 status=-1 时仍可命中 -->
            <if test="q.status == null">
                AND status &gt;= 0
            </if>
            <if test="q.status != null">
                AND status = #{q.status}
            </if>
            <if test="q.type != null">
                AND type = #{q.type}
            </if>
            <if test="q.orderNo != null and q.orderNo != ''">
                AND order_no = #{q.orderNo}
            </if>
            <if test="q.aftersaleNo != null and q.aftersaleNo != ''">
                AND aftersale_no = #{q.aftersaleNo}
            </if>
            <if test="q.userId != null">
                AND user_id = #{q.userId}
            </if>
            <if test="q.merchantId != null">
                AND merchant_id = #{q.merchantId}
            </if>
            <if test="q.startTime != null">
                AND create_time &gt;= #{q.startTime}
            </if>
            <if test="q.endTime != null">
                AND create_time &lt;= #{q.endTime}
            </if>
        </where>
        ORDER BY id DESC
    </select>

    <select id="selectPendingByStatuses" resultMap="TicketResultMap">
        SELECT <include refid="TicketColumns"/>
        FROM aftersale_ticket
        WHERE active_flag = 1
          AND status IN
          <foreach collection="statuses" item="s" open="(" separator="," close=")">
              #{s}
          </foreach>
        ORDER BY id ASC
        LIMIT #{limit}
    </select>

    <select id="selectTimedOut" resultMap="TicketResultMap">
        SELECT <include refid="TicketColumns"/>
        FROM aftersale_ticket
        WHERE active_flag = 1
          AND create_time &lt;= #{before}
          AND status IN
          <foreach collection="statuses" item="s" open="(" separator="," close=")">
              #{s}
          </foreach>
        ORDER BY id ASC
        LIMIT #{limit}
    </select>

    <update id="updateStatus">
        UPDATE aftersale_ticket
        SET status = #{status}
        <if test="releaseActive">
            , active_flag = NULL
        </if>
        <if test="logisticsInfo != null">
            , logistics_info = #{logisticsInfo, typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler}
        </if>
        <if test="refundDetail != null">
            , refund_detail = #{refundDetail, typeHandler=com.baomidou.mybatisplus.extension.handlers.JacksonTypeHandler}
        </if>
        WHERE id = #{id}
    </update>
</mapper>
