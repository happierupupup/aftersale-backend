<?xml version="1.0" encoding="UTF-8"?>
<definitions xmlns="http://www.omg.org/spec/BPMN/20100524/MODEL"
             xmlns:activiti="http://activiti.org/bpmn"
             typeLanguage="http://www.w3.org/2001/XMLSchema"
             expressionLanguage="http://www.w3.org/1999/XPath"
             targetNamespace="http://yean.com/aftersale">
  <process id="refund" name="仅退款流程" isExecutable="true">
    <startEvent id="start" name="开始"/>
    <userTask id="merchantApprove" name="商家审核" activiti:candidateGroups="MERCHANT"/>
    <userTask id="merchantRefund" name="商家退款" activiti:candidateGroups="MERCHANT"/>
    <endEvent id="end" name="结束"/>
    <sequenceFlow sourceRef="start" targetRef="merchantApprove"/>
    <sequenceFlow sourceRef="merchantApprove" targetRef="merchantRefund"/>
    <sequenceFlow sourceRef="merchantRefund" targetRef="end"/>
  </process>
</definitions>
