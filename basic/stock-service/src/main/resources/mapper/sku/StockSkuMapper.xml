<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yean.stock.sku.mapper.StockSkuMapper">

    <resultMap id="StockSkuResultMap" type="com.yean.stock.sku.dto.StockSku">
        <id column="id" property="id"/>
        <result column="sku_id" property="skuId"/>
        <result column="sku_name" property="skuName"/>
        <result column="warn_threshold" property="warnThreshold"/>
        <result column="update_by" property="updateBy"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <resultMap id="SkuDetailResultMap" type="com.yean.stock.sku.dto.SkuDetail">
        <id column="id" property="id"/>
        <result column="sku_id" property="skuId"/>
        <result column="sku_name" property="skuName"/>
        <result column="stock_num" property="stockNum"/>
        <result column="version" property="version"/>
        <result column="warn_threshold" property="warnThreshold"/>
        <result column="update_by" property="updateBy"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <select id="selectBySkuId" resultMap="StockSkuResultMap">
        SELECT id, sku_id, sku_name, warn_threshold, update_by, create_time, update_time
        FROM stock_sku
        WHERE sku_id = #{skuId}
    </select>

    <select id="selectDetailBySkuId" resultMap="SkuDetailResultMap">
        SELECT s.id, s.sku_id, s.sku_name, c.stock_num, c.version, s.warn_threshold, s.update_by, s.update_time
        FROM stock_sku s
        LEFT JOIN stock_count c ON s.sku_id = c.sku_id
        WHERE s.sku_id = #{skuId}
    </select>

    <select id="selectDetailList" resultMap="SkuDetailResultMap">
        SELECT s.id, s.sku_id, s.sku_name, c.stock_num, c.version, s.warn_threshold, s.update_by, s.update_time
        FROM stock_sku s
        LEFT JOIN stock_count c ON s.sku_id = c.sku_id
        <where>
            <if test="q.skuId != null">
                AND s.sku_id = #{q.skuId}
            </if>
            <if test="q.skuName != null and q.skuName != ''">
                AND s.sku_name LIKE CONCAT('%', #{q.skuName}, '%')
            </if>
        </where>
        ORDER BY s.id ASC
    </select>
</mapper>
