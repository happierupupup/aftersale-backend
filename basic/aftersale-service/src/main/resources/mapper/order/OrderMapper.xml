<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yean.aftersale.order.mapper.OrderMapper">

    <resultMap id="OrderResultMap" type="com.yean.aftersale.order.dto.OrderInfo">
        <id column="id" property="id"/>
        <result column="order_no" property="orderNo"/>
        <result column="user_id" property="userId"/>
        <result column="merchant_id" property="merchantId"/>
        <result column="sku_id" property="skuId"/>
        <result column="sku_name" property="skuName"/>
        <result column="num" property="num"/>
        <result column="amount" property="amount"/>
        <result column="status" property="status"/>
        <result column="pay_status" property="payStatus"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="OrderColumns">
        id, order_no, user_id, merchant_id, sku_id, sku_name, num, amount, status, pay_status, create_time, update_time
    </sql>

    <select id="selectByOrderNo" resultMap="OrderResultMap">
        SELECT <include refid="OrderColumns"/>
        FROM order_info
        WHERE order_no = #{orderNo}
    </select>

    <select id="selectByUserId" resultMap="OrderResultMap">
        SELECT <include refid="OrderColumns"/>
        FROM order_info
        <where>
            <if test="userId != null">
                AND user_id = #{userId}
            </if>
        </where>
        ORDER BY id DESC
    </select>
</mapper>
