<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yean.portal.notify.mapper.NotifyMapper">

    <resultMap id="NotifyResultMap" type="com.yean.portal.notify.entity.Notify">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="title" property="title"/>
        <result column="content" property="content"/>
        <result column="channel" property="channel"/>
        <result column="biz_type" property="bizType"/>
        <result column="read_flag" property="readFlag"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <select id="selectNotifyList" resultMap="NotifyResultMap">
        SELECT id, user_id, title, content, channel, biz_type, read_flag, create_time
        FROM sys_notify
        <where>
            <if test="q.userId != null">
                AND user_id = #{q.userId}
            </if>
            <if test="q.channel != null and q.channel != ''">
                AND channel = #{q.channel}
            </if>
            <if test="q.readFlag != null">
                AND read_flag = #{q.readFlag}
            </if>
        </where>
        ORDER BY id DESC
    </select>
</mapper>
