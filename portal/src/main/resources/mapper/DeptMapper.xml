<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yean.portal.dept.mapper.DeptMapper">

    <resultMap id="DeptResultMap" type="com.yean.portal.dept.entity.Dept">
        <id column="id" property="id"/>
        <result column="name" property="name"/>
        <result column="parent_id" property="parentId"/>
        <result column="level" property="level"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="DeptColumns">
        id, name, parent_id, level, create_time, update_time
    </sql>

    <select id="selectDeptList" resultMap="DeptResultMap">
        SELECT <include refid="DeptColumns"/>
        FROM sys_dept
        <where>
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
            <if test="parentId != null">
                AND parent_id = #{parentId}
            </if>
        </where>
        ORDER BY level ASC, id ASC
    </select>

    <select id="countByParentId" resultType="int">
        SELECT COUNT(1)
        FROM sys_dept
        WHERE parent_id = #{parentId}
    </select>
</mapper>
