<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.yean.portal.user.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.yean.portal.user.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="role" property="role"/>
        <result column="dept_id" property="deptId"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
    </resultMap>

    <sql id="UserColumns">
        id, username, password, role, dept_id, status, create_time, update_time
    </sql>

    <select id="selectByUsername" resultMap="UserResultMap">
        SELECT <include refid="UserColumns"/>
        FROM sys_user
        WHERE username = #{username}
    </select>

    <select id="selectUserList" resultMap="UserResultMap">
        SELECT DISTINCT u.id, u.username, u.password, u.role, u.dept_id, u.status, u.create_time, u.update_time
        FROM sys_user u
        LEFT JOIN sys_user_role ur ON ur.user_id = u.id
        <where>
            <if test="q.username != null and q.username != ''">
                AND u.username LIKE CONCAT('%', #{q.username}, '%')
            </if>
            <if test="q.role != null and q.role != ''">
                AND ur.role = #{q.role}
            </if>
            <if test="q.deptId != null">
                AND u.dept_id = #{q.deptId}
            </if>
            <if test="q.status != null">
                AND u.status = #{q.status}
            </if>
        </where>
        ORDER BY u.id DESC
    </select>

    <select id="countByDeptId" resultType="int">
        SELECT COUNT(1)
        FROM sys_user
        WHERE dept_id = #{deptId}
    </select>
</mapper>
